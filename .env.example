# FAST SERVICES / FAST ENGINEERING SOLUTIONS
# Configuration variables for Production and Development

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Application Settings
NEXT_PUBLIC_APP_NAME="FAST SERVICES"
NEXT_PUBLIC_COMPANY_NAME="FAST ENGINEERING SOLUTIONS"
NEXT_PUBLIC_SITE_URL=https://fastservices.vercel.app

# Environment Mode: 'production' | 'development' | 'test'
NODE_ENV=production
